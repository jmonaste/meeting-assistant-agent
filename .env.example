# OpenAI-compatible endpoint serving the model(s) (must end in /v1)
OPENAI_BASE_URL=http://localhost:8000/v1
# Any non-empty string if the endpoint ignores it
OPENAI_API_KEY=not-needed

# Model used for the per-chunk map phase (many small, parallel calls)
MEETING_WORKER_MODEL=gemma
# Model used for planning, synthesis and the coverage sweeps (fewer, harder calls)
MEETING_LEAD_MODEL=gpt-oss

# Sampling temperature for all calls (keep at 0 for reproducible reports)
MEETING_TEMPERATURE=0

# Verify the endpoint's TLS certificate. Set to false ONLY for a trusted
# local/corporate endpoint that uses a self-signed certificate.
MEETING_VERIFY_SSL=true
# HTTP timeout in seconds per LLM call (local models can be slow to respond)
MEETING_REQUEST_TIMEOUT=120

# Max completion tokens per call. Reasoning models (e.g. gpt-oss) spend tokens
# thinking before answering; too low a budget truncates the JSON and validation
# fails ("EOF while parsing"). Raise this if extractions come back truncated.
MEETING_MAX_TOKENS=8192

# Max parallel LLM calls during the map/sweep phases (match your endpoint capacity)
MEETING_MAX_CONCURRENCY=4

# Character budget for a single transcript chunk handed to the worker model.
MEETING_CHUNK_MAX_CHARS=9000
# Characters of overlap between adjacent chunks, so an item that straddles a
# chunk boundary is still seen whole by at least one chunk.
MEETING_CHUNK_OVERLAP_CHARS=800

# How many extra full-transcript coverage sweeps to run after the first pass.
# Each sweep re-reads the WHOLE transcript hunting for items the earlier passes
# missed. Sweeps stop early once a full round finds nothing new.
MEETING_MAX_SWEEPS=3
# Tool-loop iteration cap for the evidence/clarification agents.
MEETING_AGENT_MAX_ITERATIONS=8

# Reuse cached per-chunk extractions when the chunk text has not changed.
MEETING_USE_CACHE=true
