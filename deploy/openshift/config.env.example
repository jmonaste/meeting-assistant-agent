# Copy to config.env (git-ignored), fill in, then create the ConfigMap:
#   oc create configmap meeting-assistant-config --from-env-file=deploy/openshift/config.env
# Same variables as the CLI's .env (see .env.example for what each one does),
# EXCEPT the API key, which goes in a Secret:
#   oc create secret generic meeting-assistant-secrets --from-literal=OPENAI_API_KEY=<key>
#
# NOTE: the URL must be reachable FROM THE POD, which may differ from what works
# on your laptop (an internal host name instead of localhost, a different proxy).

OPENAI_BASE_URL=https://llm.example.internal/v1
MEETING_WORKER_MODEL=gemma
MEETING_LEAD_MODEL=gpt-oss

# A single large model behind a gateway: start from the safe baseline
# (docs/07-Endpoint-Tuning.md) and raise it once runs are clean.
MEETING_MAX_CONCURRENCY=1
MEETING_CHUNK_MAX_CHARS=5000
MEETING_REQUEST_TIMEOUT=300
MEETING_MAX_TOKENS=8192
MEETING_MAX_SWEEPS=3
MEETING_LANGUAGE=auto
MEETING_VERIFY_SSL=true

# Recent langchain-openai versions replace the httpx transport to add TCP
# keepalive options, which can bypass the proxy settings below. 0 turns that off
# (the same setting that was needed on the corporate laptop).
LANGCHAIN_OPENAI_TCP_KEEPALIVE=0

# Do NOT set SSL_CERT_FILE / REQUESTS_CA_BUNDLE here, and never a Windows path:
# the container entrypoint sets both from the CA mounted via the
# meeting-assistant-ca ConfigMap (docs/08, step 4).
# MEETING_LOG_FILE is not needed either: every job keeps its own run.log.

# Outbound proxy, if the pod must use one to reach the endpoint. Put internal
# hosts that must NOT go through the proxy in NO_PROXY.
# HTTPS_PROXY=http://proxy.example.internal:8080
# HTTP_PROXY=http://proxy.example.internal:8080
# NO_PROXY=.example.internal,.svc,.cluster.local,localhost,127.0.0.1
